# ------------------------------------------------------------------
# Kanya Jewelers - Backend Environment Variables
# Copy this file to ".env" and fill in real values. NEVER commit .env
# ------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://kanya_user:kanya_password@localhost:5432/kanya_jewelers

# JWT auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Default admin account (only used the FIRST time the DB is seeded)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-strong-password

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend-domain.com

# --------------------------------------------------------------
# Image storage. Two options:
#   1) Cloudinary (recommended for production)
#   2) Local disk storage under /static/uploads (fallback/dev)
# If Cloudinary keys are present, Cloudinary is used automatically.
# --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public base URL of this backend (used to build local image URLs)
BACKEND_BASE_URL=http://localhost:8000
